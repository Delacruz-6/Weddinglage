# Copiar a .env y ajustar. No commitear .env.

POSTGRES_DB=weddinglage
POSTGRES_USER=wedding
POSTGRES_PASSWORD=change-me

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-too
MINIO_BUCKET=wedding-photos
MINIO_REGION=us-east-1

# Admin seed (solo desarrollo)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin

# App (Compose fija hosts de servicio: postgres, minio, mailhog)
APP_BASE_URL=http://localhost
JWT_NOT_USED=cookie-session
# Pepper para hashes de tokens (generar valor aleatorio largo)
TOKEN_PEPPER=replace-with-long-random-string

# Optional: Spotify Web API (Client Credentials) to list tracks for next/prev in the player.
# Without these, the player still plays the playlist URI via Spotify Embed (first song on Entrar).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
